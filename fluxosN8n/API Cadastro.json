        "jsCode": "const key = $input.first().json.master_key_transito || \"\";\n\nconst crypto = require('crypto');\n\nreturn $input.all().map(item => {\n  try {\n    const text = $('Webhook').first().json.body.chave_gemini_recebida;\n    // O n8n moderno às vezes injeta o crypto globalmente\n    const iv = crypto.randomBytes(16);\n    const cipher = crypto.createCipheriv('aes-256-cbc', key, iv);\n    \n    let encrypted = cipher.update(text, 'utf8', 'hex');\n    encrypted += cipher.final('hex');\n    \n    item.json.encrypted_key = iv.toString('hex') + ':' + encrypted;\n  } catch (e) {\n    item.json.error = e.message;\n  }\n  return item;\n});"
